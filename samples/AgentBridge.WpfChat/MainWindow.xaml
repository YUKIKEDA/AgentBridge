<Window x:Class="AgentBridge.WpfChat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AgentBridge Sample Chat"
        Height="520"
        Width="720"
        MinHeight="360"
        MinWidth="480">
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Bottom" LastChildFill="True" Margin="0,8,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                <Button x:Name="SendButton" Content="送信" Width="72" Margin="0,0,8,0" Click="OnSendClick" />
                <Button x:Name="StopButton" Content="Stop" Width="72" IsEnabled="False" Click="OnStopClick" />
            </StackPanel>
            <TextBox x:Name="InputBox"
                     MinHeight="48"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" />
        </DockPanel>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap" />
        <TextBox x:Name="Transcript"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Disabled"
                 FontFamily="Consolas" />
    </DockPanel>
</Window>
